WARPDRIVE_ADMIN_ACCESS_KEY=adminkey
WARPDRIVE_ADMIN_SECRET_KEY=adminsecretkey123456
WARPDRIVE_PORT=9710
STORAGE_DIRECTORY=/var/lib/warpdrive/storage

# Single-node by default -- no peers, nothing to cluster with on one
# machine. To make this host a member of a distributed cluster instead,
# install the same package on every host, then uncomment and fill in
# below on each one (same WARPDRIVE_PEERS list everywhere, including
# this host's own address; WARPDRIVE_SELF_ADDR is how the others reach
# THIS host specifically) and restart: `sudo systemctl restart warpdrive`.
# Same binary, same S3 endpoint either way -- see docs/user_guide.md's
# "Distributed Mode" section.
#WARPDRIVE_PEERS=http://host1:9710,http://host2:9710,http://host3:9710,http://host4:9710,http://host5:9710
#WARPDRIVE_SELF_ADDR=http://THIS-HOST:9710
#WARPDRIVE_RS_K=3
#WARPDRIVE_RS_M=2
